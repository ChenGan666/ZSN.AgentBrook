  "ClawAI": {
    "GreetingDetection": {
      "MaxLength": 20,
      "Patterns": [
        "你好",
        "嗨",
        "hello",
        "hi",
        "早上好",
        "晚上好",
        "下午好",
        "在吗",
        "在不在",
        "哈喽",
        "嘿"
      ],
      "SimpleConversationPatterns": [
        "谢谢",
        "感谢",
        "再见",
        "拜拜",
        "好的",
        "行",
        "可以"
      ]
    },
    "Memory": {
      "WorkingMemoryLimit": 10,
      "EpisodicMemoryLimit": 5,
      "LongTermMemoryLimit": 3,
      "ArchiveImportanceThreshold": 60,
      "UserProfileMaxLength": 500,
      "InteractionPatternMaxLength": 500,
      "EnableAutoKnowledgeExtraction": true,
      "EnableMemoryPriorityAnswer": true,
      "MinDialogueLengthForExtraction": 20,
      "AutoMergePeriodHours": 24
    },
    "Planning": {
      "SimpleTaskMaxSteps": 2,
      "MediumTaskMaxSteps": 5,
      "HistoricalPlansLimit": 5,
      "KnowledgeQueryPatterns": [
        "是什么",
        "什么是",
        "介绍",
        "解释",
        "说明",
        "定义",
        "为什么",
        "怎么样",
        "如何理解",
        "什么意思",
        "告诉我",
        "我想知道",
        "请问"
      ],
      "SimpleTaskPatterns": [
        "查询",
        "搜索",
        "找",
        "查找",
        "显示",
        "列出",
        "帮我看",
        "看看"
      ],
      "ComplexTaskPatterns": [
        "分析并",
        "首先.*然后",
        "生成.*并",
        "处理.*再",
        "对比",
        "比较",
        "制定",
        "设计",
        "规划",
        "优化",
        "改进",
        "评估.*并",
        "创建.*并",
        "编写.*并",
        "制作.*并"
      ],
      "PureAnalysisPatterns": [
        "分析用户",
        "明确目标",
        "理解意图",
        "制定策略",
        "仅分析",
        "仅明确",
        "仅理解",
        "仅制定"
      ],
      "WorkflowMatchThreshold": 0.02,
      "WorkflowKeywordsCount": 5
    },
    "SimilarityThresholds": {
      "MemoryFastPath": 0.3,
      "EpisodicMemory": 0.25,
      "WorkflowMatch": 0.02
    },
    "TaskComplexity": {
      "SimpleTaskMaxLength": 50,
      "ComplexTaskMinLength": 200,
      "KnowledgeQueryMaxLength": 100,
      "TaskConnectors": [
        "并",
        "然",
        "再",
        "接"
      ]
    },
    "Reflection": {
      "SimpleTaskMaxSteps": 2,
      "SimpleTaskOverallQuality": 85,
      "SimpleTaskCompletenessScore": 90,
      "SimpleTaskAccuracyScore": 80,
      "HighQualityStepThreshold": 80,
      "MostlyCompletedRatio": 0.8,
      "MostlyCompletedOverallQuality": 90,
      "MostlyCompletedCompletenessScore": 95,
      "AllCompletedOverallQuality": 95,
      "AllCompletedCompletenessScore": 98,
      "AllCompletedAccuracyScore": 95,
      "MaxIterationOverallQuality": 70,
      "MaxIterationCompletenessScore": 75,
      "MaxIterationAccuracyScore": 70,
      "NoReplanIterationThreshold": 2,
      "NoReplanStepThreshold": 2
    },
    "MemoryConsolidation": {
      "Enabled": true,
      "CronLookbackMinutes": 1440,
      "IntervalLookbackMultiplier": 1.5,
      "PromotionGeneralityThreshold": 70,
      "PromotionMinImportance": 60,
      "PromotionMaxPerRun": 50
    }
  },
  "ResearchNode": {
    "SearXNGBaseUrl": "http://localhost:8800",
    "SearchTimeoutSeconds": 10,
    "MaxResultsPerQuery": 10,
    "MaxConcurrentFetches": 3,
    "PageTimeoutSeconds": 30,
    "MaxContentLength": 5000,
    "Headless": true,
    "DefaultMaxIterations": 3,
    "DefaultMaxFetchUrls": 5,
    "DefaultSearchLanguage": "zh-CN",
    "DefaultMaxLLMCalls": 6,
    "DefaultCompletionThreshold": 0.8,
    "BrowserUserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    "BlockedDomains": [
      "doubleclick.net",
      "ads.google.com"
    ],
    "EnableContentCache": true,
    "CacheExpiryHours": 24,
    "OverallTimeoutMinutes": 5
  },
  "KnowledgeBase": {
    "ImageBaseUrl": "http://127.0.0.1:5003"
  },
  "ImageProcessing": {
    "Enabled": true,
    "SupportedFormats": [ "png", "jpg", "jpeg", "bmp", "tiff", "gif", "webp" ],
    "Storage": {
      "Type": "file",
      "RootPath": "./DocumentImages"
    },
    "VLM": {
      "Concurrency": 3
    }
  },
  "VoiceNodeOptions": {
    "DefaultProvider": "FunASR",
    "MaxConcurrentSegments": 4,
    "MaxFileSizeMb": 500,
    "MaxProcessingTimeMinutes": 15,
    "AutoSegmentThresholdSeconds": 300,
    "SupportedFormats": [ ".wav", ".mp3", ".pcm", ".m4a", ".ogg", ".flac", ".aac", ".wma", ".mp4", ".avi", ".mkv", ".mov" ],
    "DefaultSystemPrompt": "请对以下语音转写文本进行整理，修正标点符号和明显错误，并生成简要摘要。",
    "TempFileDirectory": "",
    "FFmpegPath": "",
    "KeepRawResponse": false,
    "CircuitBreakerThreshold": 3,
    "CircuitBreakerRecoverySeconds": 60
  },
  "FunASROptions": {
    "ServerUrl": "ws://localhost:10095",
    "ChunkSize": 9600,
    "ConnectTimeoutSeconds": 5,
    "TranscribeTimeoutMinutes": 10
  }
