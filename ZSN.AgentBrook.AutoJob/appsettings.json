    "PandocPath": "pandoc"
  },

  "Skill": {
    "Directory": "W:/AI/ZSN.AI/publish/Skill"
  },

  "VLLLMConfig": {
    "Name": "qwen2.5vl:7b",
    "ModelName": "qwen2.5vl:7b",
    "ModelKey": "123456",
    "ModelOrganizationName": "Ollama",
    "EndPoint": "http://localhost:11434/",
    "MConfig": "{}",
    "Temperature": 0.75,
    "TopPCoefficient": 0.95,
    "SystemPrompt": "请将图片内容转写为 Markdown 文本，要求：保持原有结构和格式（标题、段落、列表等）。1、准确识别文字，转写为对应的 Markdown。2、表格 → 转为 Markdown 表格。3、图表/示意图 → 用文字详细描述，并可用表格补充关键数据。4、公式 → 用 LaTeX 表达（$...$ 或 $$...$$）。5、非文字图片/插图 → 用 ![描述](#) 并详细描述内容。6、Markdown 语法必须正确，可直接渲染。"
  },
  "FileToMarkdownReCallUrl": "http://127.0.0.1:5003/api/Task/ReCall?sessionID={sessionID}&taskID={taskID}&appID={appID}&recordID={recordID}",
  "HumanOperationReCallUrl": "http://127.0.0.1:5003/api/Task/ReCall?sessionID={sessionID}&taskID={taskID}&appID={appID}&recordID={recordID}",
  "ExternalUrl": "http://127.0.0.1:5008",

  "DocumentStorage": {
    "RootPath": "./Documents",
    "EnableFileSync": true,
    "AutoCreateDirectories": true
  },
  "LargeModel": {
    "ChatModelID": 13,
    "EmbeddingModelID": 12,
    "MemoryConsolidationModelID": 13
  },


