@using ZSN.AI.Entity.Model.Enum
@{
    var lst = ViewBag.KnowledgeBaseFileList as List<KnowledgeBaseFileInfo>;
}
@section Css{
}
<div class="layui-fluid">
    <div class="layui-row layui-col-space15">
        <div class="layui-col-md12">
            <div class="layui-card">
                <div class="layui-card-body">
                    <div class="layui-input-inline layui-show-xs-block">
                        <button class="layui-btn add_bt" >
                            <i class="layui-icon"></i>上传
                        </button>
                    </div>
                    <div class="layui-input-inline layui-show-xs-block">
                        <button class="layui-btn layui-btn-danger delete-selected_bt">删除选中</button>
                    </div>
                    <hr>
                </div>
                <div class="layui-card-body">
                    <table class="layui-table layui-form">
                        <colgroup>
                            <col width="10">
                            <col>
                            <col>
                            <col width="50">
                            <col width="50">
                            <col width="50">
                            <col width="200">
                        </colgroup>
                        <thead>
                            <tr>
                                <th style="white-space: nowrap;">
                                    <input type="checkbox" class="check-all" lay-skin="primary" lay-filter="check-all" /> 编号
                                </th>
                                <th>名称</th>
                                <th>路径</th>
                                <th>分块数</th>
                                <th>创建时间</th>
                                <th>状态</th>
                                <th>设置</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var KnowledgeBaseFile in lst)
                            {
                                <tr data-FileID="@KnowledgeBaseFile.FileID">
                                    <td style="white-space: nowrap;">
                                        <input type="checkbox" class="check-item" value="@KnowledgeBaseFile.FileID" lay-skin="primary" lay-filter="check-item" />
                                        <span>@KnowledgeBaseFile.FileID</span>
                                    </td>
                                    <td>@KnowledgeBaseFile.FileName</td>
                                    <td>@KnowledgeBaseFile.FilePath</td>
                                    <td>@KnowledgeBaseFile.DataCount</td>
                                    <td>@KnowledgeBaseFile.CreateTime</td>
                                <td>
                                        @(KnowledgeBaseFile.SystemStatus == ImportKmsStatus.Fail ? "失败" : KnowledgeBaseFile.SystemStatus == ImportKmsStatus.Watting ? "未处理" : KnowledgeBaseFile.SystemStatus == ImportKmsStatus.Loadding ? "分析中" : KnowledgeBaseFile.SystemStatus == ImportKmsStatus.Success ? "完成" : "")
                                </td>
                                <td>
                                    <div style="white-space: nowrap;">
                                        @if(KnowledgeBaseFile.SystemStatus == ImportKmsStatus.Success)
                                        {
                                            <button class="layui-btn edit_bt" data-id="@KnowledgeBaseFile.FileID">
                                                查看分块
                                            </button>
                                        }
                                        <button class="layui-btn tool-dropdown-file">
                                            <span>更多</span>
                                            <i class="layui-icon layui-icon-down layui-font-12"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="layui-card-body ">
                    <div class="pagination" id="pageId">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Js{
    <script>
        layui.use(function () {
            var form = layui.form;
            var laypage = layui.laypage;
            var dropdown = layui.dropdown;
            form.render();

            // 渲染下拉菜单
            dropdown.render({
              elem: '.tool-dropdown-file',
              data: [{
                title: '分块处理',
                id: 'process'
              },{
                title: '删除',
                id: 'delete'
              }],
              click: function(obj){
                var $btn = $(this.elem);
                var $tr = $btn.parents('tr');
                var fileId = $tr.data('fileid');
                
                if(obj.id === 'process') {
                  // 分块处理功能
                  layer.confirm("文件进入分块分析处理过程中会重置该文件原有分块数据，分块过程请确保异步任务服务正常运行!", { title: "确认分块分析" }, function (index) {
                    $.ajax({
                      url: '@Url.Action("KnowledgeBaseFileToJob")',
                      type: 'POST',
                      data: {
                        KnowledgeBaseID: '@ViewBag.KnowledgeBaseID',
                        FileID: fileId
                      },
                      success: function (res) {
                        layer.msg(res.msg, { icon: 1, time: 1000 }, function () { location.reload(); });
                      }
                    });
                  });
                } 
                if(obj.id === 'delete') {
                  // 删除功能
                  layer.confirm("确认要删除吗,删除后不能恢复!", { title: "删除确认" }, function (index) {
                    $.ajax({
                      url: '@Url.Action("KnowledgeBaseFileDel")',
                      type: 'POST',
                      data: {
                        mid: fileId,
                        KnowledgeBaseID:'@ViewBag.KnowledgeBaseID'
                      },
                      success: function (res) {
                        layer.msg(res.msg, { icon: 1, time: 1000 }, function () { location.reload(); });
                      }
                    });
                  });
                }
              }
            });

            laypage.render({
                elem: 'pageId'
                , count: @ViewBag.Total
                            , limit: @ViewBag.Size
                            , curr: @ViewBag.Index
                            , layout: ['count', 'prev', 'page', 'next', 'limit', 'refresh', 'skip']
                , jump: function (obj, f) {
                    if (f)
                        return;
                    location.href = "@Url.Action("filelist")?KnowledgeBaseID=@ViewBag.KnowledgeBaseID&index=" + obj.curr + "&size=" + obj.limit;
                }
            });

            /*新增*/
            $('.add_bt').click(function () {
                var url = '@Url.Action("EditFile")' + '?KnowledgeBaseID=@ViewBag.KnowledgeBaseID';
                layer.open({
                    type: 2,
                    title: '上传文件',
                    shadeClose: true,
                    shade: 0.8,
                    area: ['60%', '275px'],
                    content: url
                });
            });

            /*查看*/
            $('.edit_bt').click(function () {
                var FileID = $(this).data('id');;
                var url = '@Url.Action("EditFile")' + "?KnowledgeBaseID=@ViewBag.KnowledgeBaseID&FileID=" + FileID;
                layer.open({
                    type: 2,
                    title: '查看分块',
                    shadeClose: true,
                    shade: 0.8,
                    area: ['100%', '100%'],
                    content: url
                });
            });

            form.on('checkbox(check-all)', function (data) {
                var checked = data.elem.checked;
                $('.check-item').prop('checked', checked);
                form.render('checkbox');
            });

            form.on('checkbox(check-item)', function (data) {
                var all = $('.check-item').length;
                var selected = $('.check-item:checked').length;
                $('.check-all').prop('checked', all > 0 && all === selected);
                form.render('checkbox');
            });

            $('.delete-selected_bt').on('click', function () {
                var ids = $('.check-item:checked').map(function(){ return $(this).val(); }).get();
                if(ids.length === 0){
                    layer.msg('请先选择要删除的记录');
                    return;
                }
                var fileId = ids.join(',');
                layer.confirm("确认要删除吗,删除后不能恢复!", { title: "删除确认" }, function (index) {
                    $.ajax({
                      url: '@Url.Action("KnowledgeBaseFileDel")',
                      type: 'POST',
                      data: {
                        mid: fileId,
                        KnowledgeBaseID:'@ViewBag.KnowledgeBaseID'
                      },
                      success: function (res) {
                        layer.msg(res.msg, { icon: 1, time: 1000 }, function () { location.reload(); });
                      }
                    });
                });
            });

        });
    </script>
}
