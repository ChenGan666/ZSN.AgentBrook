@{
    var memory = ViewBag.Memory as ZSN.AI.Entity.ClawAI.LongTermMemoryInfo;
    var memoryId = ViewBag.MemoryId as string;
}
@section Css{
    <style>
        #container {
            width: 100%;
            height: calc(100vh - 200px);
            border: 1px solid #ddd;
            background-color: #f8f9fa;
        }
        #toolbar {
            padding: 10px;
            background-color: #fff;
            border-bottom: 1px solid #ddd;
        }
        .toolbar-item {
            margin-right: 10px;
        }
        .node-info {
            padding: 15px;
            background-color: #fff;
            border: 1px solid #ddd;
            margin-top: 10px;
            display: none;
        }
        .legend-item {
            display: inline-block;
            margin-right: 15px;
            margin-bottom: 5px;
        }
        .legend-color {
            display: inline-block;
            width: 20px;
            height: 20px;
            margin-right: 5px;
            vertical-align: middle;
            border-radius: 3px;
        }
    </style>
}
<div class="layui-fluid">
    <div class="layui-row layui-col-space15">
        <div class="layui-col-md12">
            <div class="layui-card">
                <div class="layui-card-header">
                    知识图谱可视化 - @memory.Summary
                    <button class="layui-btn layui-btn-sm layui-btn-normal" style="float: right;" id="refreshBtn">
                        <i class="layui-icon">&#xe669;</i> 刷新图谱
                    </button>
                </div>
                <div class="layui-card-body">
                    <!-- 工具栏 -->
                    <div id="toolbar">
                        <div class="layui-inline">
                            <label class="layui-form-label">图谱深度</label>
                            <div class="layui-input-inline" style="width: 100px;">
                                <select id="maxDepth" lay-filter="maxDepth">
                                    <option value="1">1层</option>
                                    <option value="2" selected>2层</option>
                                    <option value="3">3层</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">布局方式</label>
                            <div class="layui-input-inline" style="width: 120px;">
                                <select id="layoutType" lay-filter="layoutType">
                                    <option value="force">力导向</option>
                                    <option value="radial">辐射</option>
                                    <option value="concentric">同心圆</option>
                                    <option value="dagre">层次结构</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline toolbar-item">
                            <button class="layui-btn layui-btn-sm" id="fitView">
                                <i class="layui-icon">&#xe66b;</i> 适应屏幕
                            </button>
                        </div>
                        <div class="layui-inline toolbar-item">
                            <button class="layui-btn layui-btn-sm" id="zoomIn">
                                <i class="layui-icon">&#xe604;</i> 放大
                            </button>
                        </div>
                        <div class="layui-inline toolbar-item">
                            <button class="layui-btn layui-btn-sm" id="zoomOut">
                                <i class="layui-icon">&#xe605;</i> 缩小
                            </button>
                        </div>
                    </div>

                    <!-- 图例 -->
                    <div style="padding: 10px; background-color: #f5f5f5; border-bottom: 1px solid #ddd;">
                        <strong>图例：</strong>
                        <div class="legend-item">
                            <span class="legend-color" style="background-color: #ff5722;"></span>
                            <span>中心节点</span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-color" style="background-color: #2196f3;"></span>
                            <span>普通节点</span>
                        </div>
                        <div style="display: inline-block; margin-left: 20px;">
                            <strong>关系类型：</strong>
                        </div>
                        <div class="legend-item">
                            <span style="border-bottom: 2px solid #999; color: #999;">────</span>
                            <span>相关</span>
                        </div>
                        <div class="legend-item">
                            <span style="border-bottom: 2px solid #4caf50; color: #4caf50;">────</span>
                            <span>前置</span>
                        </div>
                        <div class="legend-item">
                            <span style="border-bottom: 2px solid #ff9800; color: #ff9800;">────</span>
                            <span>派生</span>
                        </div>
                        <div class="legend-item">
                            <span style="border-bottom: 2px solid #f44336; color: #f44336;">────</span>
                            <span>冲突</span>
                        </div>
                    </div>

                    <!-- 图谱容器 -->
                    <div id="container"></div>

                    <!-- 节点信息面板 -->
                    <div id="nodeInfo" class="node-info">
                        <fieldset class="layui-elem-field">
                            <legend>节点详情</legend>
                            <div class="layui-field-box">
                                <div class="layui-form">
                                    <div class="layui-form-item">
                                        <label class="layui-form-label">摘要</label>
                                        <div class="layui-input-block">
                                            <div id="infoSummary" style="padding: 5px;"></div>
                                        </div>
                                    </div>
                                    <div class="layui-form-item">
                                        <label class="layui-form-label">类型</label>
                                        <div class="layui-input-block">
                                            <span id="infoType" class="layui-badge layui-bg-blue"></span>
                                        </div>
                                    </div>
                                    <div class="layui-form-item">
                                        <label class="layui-form-label">主题</label>
                                        <div class="layui-input-block">
                                            <div id="infoTopic" style="padding: 5px;"></div>
                                        </div>
                                    </div>
                                    <div class="layui-form-item">
                                        <label class="layui-form-label">重要性</label>
                                        <div class="layui-input-block">
                                            <div id="infoImportance" style="padding: 5px;"></div>
                                        </div>
                                    </div>
                                    <div class="layui-form-item">
                                        <label class="layui-form-label">内容</label>
                                        <div class="layui-input-block">
                                            <textarea id="infoContent" class="layui-textarea" readonly style="min-height: 100px;"></textarea>
                                        </div>
                                    </div>
                                    <div class="layui-form-item">
                                        <div class="layui-input-block">
                                            <button class="layui-btn layui-btn-sm" id="closeNodeInfo">关闭</button>
                                            <button class="layui-btn layui-btn-sm layui-btn-normal" id="viewDetails">查看完整详情</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Js{
    <script src="https://gw.alipayobjects.com/os/lib/antv/g6/4.8.24/dist/g6.min.js"></script>
    <script>
        let graph = null;
        let currentMemoryId = '@memoryId';

        layui.use(['form', 'layer'], function () {
            var form = layui.form;
            var layer = layui.layer;
            form.render();

            // 初始化图谱
            function initGraph() {
                const container = document.getElementById('container');
                const width = container.scrollWidth;
                const height = container.scrollHeight || 600;

                // 如果图谱已存在，销毁它
                if (graph) {
                    graph.destroy();
                }

                // 创建图谱实例
                graph = new G6.Graph({
                    container: 'container',
                    width: width,
                    height: height,
                    fitView: true,
                    fitViewPadding: 50,
                    modes: {
                        default: ['drag-canvas', 'zoom-canvas', 'drag-node', 'click-select']
                    },
                    layout: {
                        type: 'force',
                        nodeStrength: -5000,
                        edgeStrength: 0.1,
                        preventOverlap: true,
                        linkDistance: 150
                    },
                    defaultNode: {
                        size: [60, 60],
                        style: {
                            lineWidth: 2,
                            stroke: '#5B8FF9',
                            fill: '#C6E5FF'
                        },
                        labelCfg: {
                            style: {
                                fill: '#000',
                                fontSize: 12
                            },
                            position: 'bottom'
                        }
                    },
                    defaultEdge: {
                        type: 'quadratic',
                        style: {
                            lineWidth: 2,
                            stroke: '#999'
                        },
                        labelCfg: {
                            autoRotate: true,
                            style: {
                                fill: '#666',
                                fontSize: 11
                            }
                        }
                    },
                    nodeStateStyles: {
                        hover: {
                            lineWidth: 3,
                            stroke: '#1890ff'
                        },
                        selected: {
                            lineWidth: 4,
                            stroke: '#f5222d',
                            shadowColor: '#f5222d',
                            shadowBlur: 10
                        }
                    }
                });

                // 加载数据
                loadGraphData();

                // 节点点击事件
                graph.on('node:click', (evt) => {
                    const { item } = evt;
                    const model = item.getModel();
                    showNodeInfo(model);
                });

                // 监听窗口大小变化
                window.addEventListener('resize', () => {
                    if (!graph || graph.get('destroyed')) return;
                    const newWidth = container.scrollWidth;
                    const newHeight = container.scrollHeight || 600;
                    graph.changeSize(newWidth, newHeight);
                });
            }

            // 加载图谱数据
            function loadGraphData() {
                const maxDepth = $('#maxDepth').val();
                const layoutType = $('#layoutType').val();

                $.ajax({
                    url: '@Url.Action("GetGraphData")',
                    type: 'GET',
                    data: {
                        memoryId: currentMemoryId,
                        maxDepth: maxDepth,
                        maxNodes: 50
                    },
                    success: function (res) {
                        if (res.Success && res.Data) {
                            const data = res.Data;

                            // 设置节点样式
                            data.nodes.forEach(node => {
                                if (node.type === 'center') {
                                    node.size = [80, 80];
                                    node.style = {
                                        fill: '#ff5722',
                                        stroke: '#fff',
                                        lineWidth: 3
                            };
                                    node.labelCfg = {
                                        style: {
                                            fill: '#fff',
                                            fontSize: 14,
                                            fontWeight: 'bold'
                                        }
                                    };
                                } else {
                                    // 根据重要性设置节点大小
                                    const importance = node.importance || 50;
                                    const size = 50 + (importance / 100) * 30;
                                    node.size = [size, size];

                                    // 根据知识类型设置颜色
                                    const colors = {
                                        'concept': '#2196f3',
                                        'fact': '#4caf50',
                                        'procedure': '#ff9800',
                                        'experience': '#9c27b0'
                                    };
                                    const color = colors[node.knowledgeType] || '#999';
                                    node.style = {
                                        fill: color,
                                        stroke: '#fff',
                                        lineWidth: 2
                            };
                                }
                            });

                            // 设置边的样式
                            data.edges.forEach(edge => {
                                const colors = {
                                    'related': '#999',
                                    'prerequisite': '#4caf50',
                                    'derived': '#ff9800',
                                    'conflict': '#f44336',
                                    'example': '#2196f3',
                                    'category': '#9c27b0'
                                };
                                edge.style = {
                                    stroke: colors[edge.type] || '#999',
                                    lineWidth: 1 + (edge.strength || 0.5) * 2,
                                    endArrow: {
                                        path: G6.Arrow.triangle(10, 12, 0),
                                        d: 0,
                                        fill: colors[edge.type] || '#999'
                                    }
                                };
                            });

                            // 更新布局
                            graph.updateLayout({
                                type: layoutType,
                                nodeStrength: -5000,
                                edgeStrength: 0.1,
                                preventOverlap: true,
                                linkDistance: 150
                            });

                            graph.data(data);
                            graph.render();
                            graph.fitView();

                        } else {
                            layer.msg(res.ErrorDesc || '加载数据失败', { icon: 2 });
                        }
                    },
                    error: function () {
                        layer.msg('加载数据失败，请稍后重试', { icon: 2 });
                    }
                });
            }

            // 显示节点信息
            function showNodeInfo(model) {
                $('#infoSummary').text(model.fullLabel || model.label);
                $('#infoType').text(model.knowledgeType || '未知');
                $('#infoTopic').text(model.topic || '无');
                $('#infoImportance').text(model.importance || '0');
                $('#infoContent').val(model.content || '无详细内容');
                $('#nodeInfo').show();
            }

            // 刷新图谱
            $('#refreshBtn').click(function () {
                loadGraphData();
            });

            // 深度变化
            form.on('select(maxDepth)', function (data) {
                loadGraphData();
            });

            // 布局变化
            form.on('select(layoutType)', function (data) {
                loadGraphData();
            });

            // 适应屏幕
            $('#fitView').click(function () {
                graph.fitView();
            });

            // 放大
            $('#zoomIn').click(function () {
                const zoom = graph.getZoom();
                graph.zoomTo(zoom * 1.2);
            });

            // 缩小
            $('#zoomOut').click(function () {
                const zoom = graph.getZoom();
                graph.zoomTo(zoom / 1.2);
            });

            // 关闭节点信息
            $('#closeNodeInfo').click(function () {
                $('#nodeInfo').hide();
            });

            // 查看完整详情
            $('#viewDetails').click(function () {
                const nodeId = graph.findAllByState('node', 'selected')[0]?.getModel().id;
                if (nodeId) {
                    const url = '@Url.Action("Details")?memoryId=' + nodeId;
                    layer.open({
                        type: 2,
                        title: '知识详情',
                        shadeClose: true,
                        shade: 0.8,
                        area: ['80%', '80%'],
                        content: url
                    });
                }
            });

            // 初始化
            initGraph();
        });
    </script>
}
