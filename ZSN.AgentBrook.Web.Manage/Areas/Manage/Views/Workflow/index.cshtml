@{

    var lst = ViewBag.AppList as List<WorkflowInfo>;

}
@section Css {
}
<div class="layui-fluid">
    <div class="layui-row layui-col-space15">
        <div class="layui-col-md12">
            <div class="layui-card">
                <div class="layui-card-body">
                    <div class="layui-input-inline layui-show-xs-block">
                        <button class="layui-btn add_bt">
                            <i class="layui-icon"></i>新建
                        </button>
                    </div>
                    <div class="layui-input-inline layui-show-xs-block">
                        <button class="layui-btn layui-btn-danger delete-selected_bt">删除选中</button>
                    </div>
                    <hr>
                </div>
                <div class="layui-card-body">
                    <table class="layui-table layui-form">
                        <colgroup>
                            <col width="100">
                            <col>
                            <col>
                            <col width="50">
                            <col width="50">
                            <col width="50">
                            <col width="200">
                        </colgroup>
                        <thead>
                            <tr>
                                <th style="white-space: nowrap;">
                                    <input type="checkbox" class="check-all" lay-skin="primary" lay-filter="check-all" /> 编号
                                </th>
                                <th>名称</th>
                                <th>描述</th>
                                <th>创建时间</th>
                                <th>更新时间</th>
                                <th>状态</th>
                                <th>设置</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var Workflow in lst)

                            {
                                <tr data-id="@Workflow.WorkflowID" data-type="@Workflow.MainType" data-mainid="@Workflow.MainID" data-name="@Workflow.WorkflowName">
                                    <td style="white-space: nowrap;">
                                        <input type="checkbox" class="check-item" value="@Workflow.WorkflowID" lay-skin="primary" lay-filter="check-item" />
                                        <span>@Workflow.WorkflowID</span>
                                    </td>
                                    <td>@Workflow.WorkflowName</td>
                                    <td>@Workflow.Description</td>

                                    <td>@Workflow.CreateTime</td>
                                    <td>@Workflow.LastUpdateTime</td>
                                    <td>
                                        <input type="checkbox" name="switch" lay-text="正常|屏蔽" lay-skin="switch" lay-filter="status" @(Workflow.SystemStatus == WorkflowStatus.Normal ? "checked" : "")>
                                    </td>
                                    <td>
                                        <div class="layui-btn-container" style="white-space: nowrap;">
                                            <button class="layui-btn edit_bt">
                                                编辑
                                            </button>
                                            <button class="layui-btn tool-dropdown-base">
                                                <span>更多</span>
                                                <i class="layui-icon layui-icon-down layui-font-12"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="layui-card-body ">
                    <div class="pagination" id="pageId">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Js {
    <script>
        layui.use(function () {
            var form = layui.form;
            var laypage = layui.laypage;
            form.render();

                    var dropdown = layui.dropdown;

        // 渲染

        dropdown.render({
          elem: '.tool-dropdown-base', 
          data: [{
            title: '复制',
            id: 'copy'
          },{
            title: '删除',
            id: 'delete'
          }],
          click: function(obj){
            var $btn = $(this.elem);
            var $tr = $btn.parents('tr');
            var workflowId = $tr.data('id');
            
            if(obj.id === 'copy') {
              // 复制功能
              layer.prompt({
                title: '请输入新工作流的名称',
                formType: 0,
                value: ''
              }, function (value, index, elem) {
                if (!value || value.trim() === '') {
                  layer.msg('工作流名称不能为空', { icon: 2 });
                  return false;
                }
                
                $.ajax({
                  url: '@Url.Action("Copy")',
                  type: 'POST',
                  data: {
                    mid: workflowId,
                    name: value.trim()
                  },
                  success: function (res) {
                    layer.close(index);
                    layer.msg(res.msg, { icon: 1, time: 1000 }, function () { location.reload(); });
                  },
                  error: function () {
                    layer.msg('复制失败', { icon: 2 });
                  }
                });
              });
            } 
            if(obj.id === 'delete') {
              // 删除功能
              layer.confirm("确认要删除吗,删除后不能恢复!", { title: "删除确认" }, function (index) {
                $.ajax({
                  url: '@Url.Action("Del")',
                  type: 'POST',
                  data: {
                    mid: workflowId
                  },
                  success: function (res) {
                    layer.msg(res.msg, { icon: 1, time: 1000 }, function () { location.reload(); });
                  }
                });
              });
            }
          }
        });

            laypage.render({
                elem: 'pageId'
                , count: @ViewBag.Total
                                    , limit: @ViewBag.Size
                                    , curr: @ViewBag.Index
                                    , layout: ['count', 'prev', 'page', 'next', 'limit', 'refresh', 'skip']
                , jump: function (obj, f) {
                    if (f)
                        return;
                    location.href = "@Url.Action("index")?index=" + obj.curr + "&size=" + obj.limit + "&type=@ViewBag.MainType&mid=@ViewBag.MainID&appid=@HttpContextHelper.Request.GetParam("appid")";
                }
            });

            /*新增*/
            $('.add_bt').click(function () {
                var url = '@Url.Action("Edit", "Workflow", new { MainID = ViewBag.MainID, MainType = ViewBag.MainType })';

                var topLayui = parent === self ? layui : top.layui;
                topLayui.index.openTabsPage(url, "新增");
                /*
                layer.open({
                    type: 2,
                    title: '新增',
                    shadeClose: true,
                    shade: 0.8,
                    area: ['100%', '100%'],
                    content: url
                });
                */
            });
            
            /*编辑*/
            $('.edit_bt').click(function () {
                var id = $(this).parents("tr").data('id');
                var url = '@Url.Action("Edit", "Workflow", new { MainID = ViewBag.MainID, MainType = ViewBag.MainType })&id='+id;

                var topLayui = parent === self ? layui : top.layui;
                topLayui.index.openTabsPage(url, "编辑");
                /*
                layer.open({
                    type: 2,
                    title: '编辑',
                    shadeClose: true,
                    shade: 0.8,
                    area: ['100%', '100%'],
                    content: url
                });
                */
            });
            
            // 全选/反选（Layui 事件）
            form.on('checkbox(check-all)', function (data) {
                var checked = data.elem.checked;
                $('.check-item').prop('checked', checked);
                form.render('checkbox');
            });

            form.on('checkbox(check-item)', function (data) {
                var all = $('.check-item').length;
                var selected = $('.check-item:checked').length;
                $('.check-all').prop('checked', all > 0 && all === selected);
                form.render('checkbox');
            });

            // 批量删除
            $('.delete-selected_bt').on('click', function () {
                var ids = $('.check-item:checked').map(function(){ return $(this).val(); }).get();
                if(ids.length === 0){
                    layer.msg('请先选择要删除的记录');
                    return;
                }
                var mids = ids.join(',');
                layer.confirm("确认要删除吗,删除后不能恢复!", { title: "删除确认" }, function (index) {
                    $.ajax({
                      url: '@Url.Action("Del")',
                      type: 'POST',
                      data: {
                        mid: mids
                      },
                      success: function (res) {
                        layer.msg(res.msg, { icon: 1, time: 1000 }, function () { location.reload(); });
                      }
                    });
                });
            });
            
            form.on('switch(status)', function (data) {
                $.ajax({
                    url: '@Url.Action("Status")',
                    type: 'POST',
                    data: {
                        mid: $(this).parents("tr").data('id'),
                        status: (this.checked ? 'true' : 'false')
                    },
                    success: function (res) {
                        layer.msg('Finish', { icon: 1, time: 1000 });
                    }
                });
            });
        });
    </script>
}
