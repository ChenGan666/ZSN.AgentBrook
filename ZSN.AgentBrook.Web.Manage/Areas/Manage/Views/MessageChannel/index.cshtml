@{
    var lst = ViewBag.ChannelList as List<ChannelConfigInfo>;
}
@section Css{
}
<div class="layui-fluid">
    <div class="layui-row layui-col-space15">
        <div class="layui-col-md12">
            <div class="layui-card">
                <div class="layui-card-body">
                    <div class="layui-input-inline layui-show-xs-block">
                        <button class="layui-btn add_bt">
                            <i class="layui-icon"></i>新建渠道
                        </button>
                    </div>
                    <div class="layui-input-inline layui-show-xs-block">
                        <button class="layui-btn layui-btn-danger delete-selected_bt">删除选中</button>
                    </div>
                    <hr>
                </div>
                <div class="layui-card-body">
                    <table class="layui-table layui-form">
                        <colgroup>
                            <col width="60">
                            <col>
                            <col>
                            <col>
                            <col width="100">
                            <col width="160">
                            <col width="80">
                            <col width="160">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" class="check-all" lay-skin="primary" lay-filter="check-all" />
                                </th>
                                <th>渠道名称</th>
                                <th>平台类型</th>
                                <th>流向</th>
                                <th>目标应用</th>
                                <th>创建时间</th>
                                <th>状态</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in lst)
                            {
                                var flowText = item.FlowDirection switch
                                {
                                    1 => "仅发送",
                                    2 => "仅接收",
                                    3 => "双向",
                                    _ => "未知"
                                };
                                var providerText = item.ProviderType switch
                                {
                                    1 => "企业微信",
                                    2 => "WhatsApp",
                                    3 => "钉钉",
                                    4 => "飞书",
                                    _ => "未知"
                                };
                                <tr data-mid="@item.ChannelID">
                                    <td>
                                        <input type="checkbox" class="check-item" value="@item.ChannelID" lay-skin="primary" lay-filter="check-item" />
                                    </td>
                                    <td>@item.ChannelName</td>
                                    <td>@providerText</td>
                                    <td>@flowText</td>
                                    <td>@(item.TargetAppID ?? "-")</td>
                                    <td>@item.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <input type="checkbox" name="switch" lay-text="启用|禁用" lay-skin="switch" lay-filter="status" @(item.Enabled == 1 ? "checked" : "")>
                                    </td>
                                    <td>
                                        <div style="white-space: nowrap;">
                                            <button class="layui-btn layui-btn-sm edit_bt">编辑</button>
                                            <button class="layui-btn layui-btn-danger layui-btn-sm del_bt">删除</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="layui-card-body">
                    <div class="pagination" id="pageId"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Js{
    <script>
        layui.use(function () {
            var form = layui.form;
            var laypage = layui.laypage;
            form.render();

            laypage.render({
                elem: 'pageId',
                count: @ViewBag.Total,
                limit: @ViewBag.Size,
                curr: @ViewBag.Index,
                layout: ['count', 'prev', 'page', 'next', 'limit', 'refresh', 'skip'],
                jump: function (obj, f) {
                    if (f) return;
                    location.href = "@Url.Action("index")?index=" + obj.curr + "&size=" + obj.limit;
                }
            });

            /* 新增 */
            $('.add_bt').click(function () {
                layer.open({
                    type: 2,
                    title: '新建渠道',
                    shadeClose: true,
                    shade: 0.8,
                    area: ['100%', '100%'],
                    content: '@Url.Action("Edit")'
                });
            });

            /* 编辑 */
            $('.edit_bt').click(function () {
                var mid = $(this).parents("tr").data('mid');
                layer.open({
                    type: 2,
                    title: '编辑渠道',
                    shadeClose: true,
                    shade: 0.8,
                    area: ['100%', '100%'],
                    content: '@Url.Action("Edit")?mid=' + mid
                });
            });

            /* 删除 */
            $('.del_bt').click(function () {
                var mid = $(this).parents("tr").data('mid');
                layer.confirm("确认要删除吗,删除后不能恢复!", { title: "删除确认" }, function (index) {
                    $.ajax({
                        url: '@Url.Action("ChannelDel")',
                        type: 'POST',
                        data: { mid: mid },
                        success: function (res) {
                            layer.msg(res.ErrorDesc, { icon: 1, time: 1000 }, function () { location.reload(); });
                        }
                    });
                });
            });

            /* 批量删除 */
            $('.delete-selected_bt').on('click', function () {
                var ids = $('.check-item:checked').map(function () { return $(this).val(); }).get();
                if (ids.length === 0) {
                    layer.msg('请先选择要删除的记录');
                    return;
                }
                layer.confirm("确认要删除吗,删除后不能恢复!", { title: "删除确认" }, function (index) {
                    $.ajax({
                        url: '@Url.Action("ChannelDel")',
                        type: 'POST',
                        data: { mid: ids.join(',') },
                        success: function (res) {
                            layer.msg(res.ErrorDesc, { icon: 1, time: 1000 }, function () { location.reload(); });
                        }
                    });
                });
            });

            /* 全选/反选 */
            form.on('checkbox(check-all)', function (data) {
                $('.check-item').prop('checked', data.elem.checked);
                form.render('checkbox');
            });
            form.on('checkbox(check-item)', function (data) {
                var all = $('.check-item').length;
                var selected = $('.check-item:checked').length;
                $('.check-all').prop('checked', all > 0 && all === selected);
                form.render('checkbox');
            });
        });
    </script>
}
