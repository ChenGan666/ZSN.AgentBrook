{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "PublishJob": {
    "轮询间隔(秒)": "PullIntervalSeconds 见下，注释仅供阅读",
    "PullIntervalSeconds": 3,
    "最大并发构建数": "MaxConcurrency 见下",
    "MaxConcurrency": 1,
    "工作区根目录(每个任务一个子目录)": "WorkspaceRoot 见下",
    "WorkspaceRoot": "./data/WS",
    "模板本地缓存目录": "TemplateCacheRoot 见下",
    "TemplateCacheRoot": "./data/TPL",
    "产物输出根目录": "ArtifactOutputRoot 见下",
    "ArtifactOutputRoot": "./data/OUT",
    "单任务构建超时(秒)": "BuildTimeoutSeconds 见下",
    "BuildTimeoutSeconds": 1800,
    "日志最大保留行数(防止 Logs 字段无限膨胀)": "MaxLogLines 见下",
    "MaxLogLines": 5000
  },

  "BuildTools": {
    "说明": "以下路径缺省走 PATH，留空即可；打包机未把工具加入 PATH 时在此显式指定",
    "GitPath": "",
    "NodePath": "",
    "NpmPath": "",
    "TauriCliPath": "",
    "DotnetPath": ""
  },

  "Templates": {
    "说明": "可用模板清单(管理后台选择用)；url 缺省时由发布任务的 TemplateGitUrl 提供",
    "Items": [
      {
        "Name": "Base",
        "DisplayName": "通用基座应用",
        "GitUrl": "",
        "DefaultRef": "main",
        "Description": "从通用客户端派生的基座模板，适用于任意 App 导出"
      },
      {
        "Name": "MeetingAssistant",
        "DisplayName": "会议助手",
        "GitUrl": "",
        "DefaultRef": "main",
        "Description": "会议记录专用模板(实时转写 + 会后纪要)"
      }
    ]
  },

  "DbConnectionStrings": {
    "JobDb": {
      "DbType": "MySql",
      "Connection": "server=localhost;userid=zsn_knowbase;password=your_password;database=zsn_knowbase;Charset=utf8mb4;SslMode=None;"
    }
  }
}
