{
  "CacheOptions": {
    "Type": "Memory",
    "FallbackToMemoryOnRedisFailure": true
  },
  "RedisConfig": {
    "ConnectionString": "localhost:6379",
    "DefaultDatabase": 0,
    "RetryCount": 3,
    "RetryDelay": 200,
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000
  },
  "MemoryCacheConfig": {
    "DefaultExpirationMinutes": 30,
    "MaxMemoryMB": 100,
    "CleanupIntervalSeconds": 60,
    "MemoryOverflowPercentage": 95,
    "EnableMemoryPressureMonitoring": true,
    "EnableVerboseLogging": false
  }
}
