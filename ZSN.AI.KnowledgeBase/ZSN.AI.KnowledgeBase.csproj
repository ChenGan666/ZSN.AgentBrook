    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="Config\entity_type_mapping.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
